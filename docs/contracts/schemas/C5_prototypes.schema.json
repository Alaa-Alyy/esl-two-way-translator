{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "C5_prototypes.schema.json",
  "title": "C5 prototypes.json",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^(S\\d{3}|NONE)$"
  },
  "additionalProperties": {
