{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "C7_sentence.schema.json",
  "title": "C7 sentence generation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text_ar_eg",
    "text_en",
    "method",
    "confidence"
  ],
  "properties": {
    "text_ar_eg": {
      "type": "string",
      "minLength": 1
    },
    "text_en": {
      "type": "string"
    },
    "audio_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "method": {
      "enum": [
        "template",
        "llm"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
